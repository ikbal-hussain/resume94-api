NODE_ENV=development
PORT=4100
# Origin allowed by CORS. Not needed when the frontend proxies /api (same-origin).
CLIENT_ORIGIN=http://localhost:5173
# MongoDB Atlas connection string (or mongodb://localhost:27017 locally).
# Atlas is a replica set, so the reset flow commits its writes in one transaction. On a
# standalone server it degrades to sequential writes and logs a warning at first use.
MONGODB_URI=
MONGODB_DB=resume94
# Required in production. Generate: openssl rand -hex 32
JWT_SECRET=
# Optional: AI endpoints return 503 when unset
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set AI_PROVIDER=groq to use Groq instead
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Password-reset email. "console" prints the link to the server log — fine for local
# work and no account needed. Set MAIL_PROVIDER=resend to send for real.
MAIL_PROVIDER=console
RESEND_API_KEY=
# Without a verified domain Resend only delivers to the address that owns the account,
# and `from` must stay onboarding@resend.dev.
MAIL_FROM=Resume94 <onboarding@resend.dev>
RESET_TOKEN_TTL_MINUTES=60
